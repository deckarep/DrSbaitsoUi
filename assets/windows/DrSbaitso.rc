// Windows resources compiled into DrSbaitsoUI.exe by build.zig: the app icon
// (Explorer, taskbar, Alt-Tab) and the version info shown in Properties.
// APP_VERSION / APP_VERSION_STR are defined by build.zig (-Dapp-version).
#include <winver.h>

1 ICON "DrSbaitso.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "deckarep"
            VALUE "FileDescription", "Dr. Sbaitso: Reborn"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "DrSbaitsoUI"
            VALUE "OriginalFilename", "DrSbaitsoUI.exe"
            VALUE "ProductName", "Dr. Sbaitso: Reborn"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
